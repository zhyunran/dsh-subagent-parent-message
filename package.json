{
  "name": "dsh-subagent-parent-message",
  "version": "0.1.1",
  "description": "Give delegated subagents a reliable subagent_parent_message tool: it resolves the direct parent session and delivers a durable peer message, even for one-shot/workflow children.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "subagent",
    "parent",
    "message"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhyunran/dsh-subagent-parent-message.git"
  },
  "homepage": "https://github.com/zhyunran/dsh-subagent-parent-message#readme",
  "bugs": {
    "url": "https://github.com/zhyunran/dsh-subagent-parent-message/issues"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  }
}
